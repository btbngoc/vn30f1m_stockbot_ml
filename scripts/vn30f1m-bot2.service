[Unit]
Description=VN30F1M Paper Trading Pipeline Service (Bot 2 - REGIME-ROUTER-02)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/vn30f1m-bot2/app

Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/vn30f1m-bot2/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=/opt/vn30f1m-bot2/app/.env

ExecStart=/opt/vn30f1m-bot2/.venv/bin/python scripts/run_cloud_paper_trading.py \
    --db-path /opt/vn30f1m-bot2/data/paper_trading.db \
    --lock-path /opt/vn30f1m-bot2/run/bot2.pid \
    --health-file /opt/vn30f1m-bot2/run/health.json \
    --audit-file /opt/vn30f1m-bot2/logs/audit/dnse_cloud_audit.jsonl

Restart=on-failure
RestartSec=30s
StartLimitIntervalSec=300
StartLimitBurst=3
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed

LimitNOFILE=65535

# --- FILESYSTEM SANDBOX & ISOLATION (ZERO TOUCH BOT 1) ---
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/vn30f1m-bot2
InaccessiblePaths=/opt/vn30f1m /var/lib/vn30f1m /var/log/vn30f1m /run/vn30f1m

# --- RESOURCE CONTROLS (TENTATIVE TEST LIMITS) ---
MemoryAccounting=yes
MemoryHigh=90M
MemoryMax=105M
MemorySwapMax=0
CPUAccounting=yes
CPUQuota=40%
TasksMax=30
Nice=10
OOMScoreAdjust=+500
OOMPolicy=kill

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vn30f1m-bot2

[Install]
WantedBy=multi-user.target
